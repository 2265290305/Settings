<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:sharedUserId="android.uid.system"

    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />
    <uses-permission android:name="android.Manifest.permission.READ_WIFI_CREDENTIAL"/>
    <uses-permission android:name="android.permission.NETWORK_SETUP_WIZARD" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- removeBond/setPairingConfirmation/setPin 等 @SystemApi 需要；priv-app + platform 签名可获批。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.DELETE_CACHE_FILES" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <!-- 一键检测 SDK 所需 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- OTA 本地安装（RecoverySystem）：重启进 recovery 刷机 / 写 /cache/recovery / 工厂重置 -->
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.ACCESS_CACHE_FILESYSTEM" />
    <uses-permission android:name="android.permission.RECOVERY" />
    <uses-permission android:name="android.permission.MASTER_CLEAR" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- 天翼规范 8.9.11：访问 Launcher 地理位置/省份码 contentProvider -->
    <uses-permission android:name="cn.dlife.smartcloud.launcher.contentprovider" />
    <!-- 系统进程跨用户投递退出登录/解绑广播 -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 拉起统一账号 APK 的协议详情页 ZpProtocolDetailActivity 需要此权限 -->
    <uses-permission android:name="com.dlife.permission.ACCESS_ACTIVITY"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <package android:name="com.yueme.itv" />
        <package android:name="com.rjsg666A" />
        <package android:name="cn.dlife.smartcloud.launcher" />
        <!-- 统一账号 APK：协议详情页 / 修改资料页 -->
        <package android:name="com.chinatelecom.accloudbox" />
        <provider android:authorities="cn.dlife.smartcloud.launcher" />
        <!-- TMC 系统升级（OTA）服务，供 RomUpgradeClient 绑定 -->
        <package android:name="com.tatv.android.TMC" />
        <intent>
            <action android:name="com.telecom.tmc.IUpgradeAidlInterface" />
        </intent>
        <intent>
            <action android:name="com.telecom.romupgrade" />
        </intent>
    </queries>

    <application
        android:persistent="true"
        android:name=".TvSettingsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="@string/app_name"

        android:sharedUserMaxSdkVersion="32"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Light"
        tools:replace="android:allowBackup,android:theme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.设置">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.android.ctcc.iotctl.action.page.net_option" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.android.ctcc.iotctl.action.page.private" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.settings.DREAM_SETTINGS" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 外部(引导入网/Launcher 等)深层跳转到设置具体子页：直达对应导航项。 -->
            <intent-filter>
                <action android:name="android.settings.PERSONALCENTER" />
                <action android:name="android.settings.NETWORK" />
                <action android:name="android.settings.BLUETOOTH" />
                <action android:name="android.settings.SOUNDDISPLAY" />
                <action android:name="android.settings.SCREENSAVER" />
                <action android:name="android.settings.ENERGY_SAVING" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainSettings"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/icon"
            android:label="@string/app_name"
            android:banner="@drawable/icon"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.settings.SETTINGS" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter
                android:priority="3">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.rockchips.android.leanbacklauncher.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".connectivity.NetworkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter
                android:priority="2">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.settings.WIFI_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_SETTINGS" />
            </intent-filter>
        </activity>

        <activity
            android:name=".accessories.AddAccessoryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.settings.BLUETOOTH_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.intent.action.CONNECT_INPUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".accessories.BluetoothRequestPermissionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.bluetooth.adapter.action.REQUEST_DISCOVERABLE" />
                <action android:name="android.bluetooth.adapter.action.REQUEST_ENABLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>



        <service
            android:name=".ImageScreenSaverDreamService"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
            </intent-filter>

            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/image_screen_saver" />
        </service>
    </application>

</manifest>
